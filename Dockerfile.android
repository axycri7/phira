# Build phira libphira.so for Android targets
# Must run as linux/amd64 — Android SDK/NDK tooling requires x86_64
FROM --platform=linux/amd64 ubuntu:22.04

ARG ANDROID_NDK_VERSION=r27c
ARG ANDROID_API=35
ARG RUST_TOOLCHAIN=nightly-2026-01-01
ARG ANDROID_TARGETS="aarch64-linux-android armv7-linux-androideabi"

ENV DEBIAN_FRONTEND=noninteractive
ENV ANDROID_HOME=/opt/android-sdk
ENV ANDROID_NDK_HOME=/opt/android-ndk-${ANDROID_NDK_VERSION}
ENV ANDROID_NDK_ROOT=${ANDROID_NDK_HOME}
ENV PATH="${ANDROID_HOME}/cmdline-tools/latest/bin:${ANDROID_HOME}/build-tools/33.0.2:${ANDROID_NDK_HOME}:${PATH}"
ENV CARGO_HOME=/cargo
ENV RUSTUP_HOME=/rustup
ENV PATH="${CARGO_HOME}/bin:${PATH}"

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    unzip \
    git \
    pkg-config \
    build-essential \
    openjdk-17-jdk-headless \
    jq \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Android SDK command-line tools
RUN mkdir -p ${ANDROID_HOME}/cmdline-tools && \
    curl --no-alpn -fL --retry 5 --retry-all-errors -o /tmp/cmdline-tools.zip \
        "https://dl.google.com/android/repository/commandlinetools-linux-11076708_latest.zip" && \
    unzip -q /tmp/cmdline-tools.zip -d /tmp/cmdline-tools-extract && \
    mv /tmp/cmdline-tools-extract/cmdline-tools ${ANDROID_HOME}/cmdline-tools/latest && \
    rm /tmp/cmdline-tools.zip

# Accept licenses and install build-tools
RUN yes | sdkmanager --licenses > /dev/null 2>&1 && \
    sdkmanager "build-tools;33.0.2" "platforms;android-${ANDROID_API}"

# Android NDK
RUN curl --no-alpn -fL --retry 5 --retry-all-errors -o /tmp/ndk.zip \
        "https://dl.google.com/android/repository/android-ndk-${ANDROID_NDK_VERSION}-linux.zip" && \
    unzip -q /tmp/ndk.zip -d /opt && \
    rm /tmp/ndk.zip

# Download rustup separately so a failed HTTPS transfer cannot be hidden by a
# shell pipeline.  The Docker amd64 network currently has an HTTP/2 ALPN
# handshake failure against static.rust-lang.org; forcing HTTP/1.x avoids it.
RUN curl --no-alpn -fL --retry 5 --retry-all-errors \
        -o /tmp/rustup-init.sh https://sh.rustup.rs && \
    sh /tmp/rustup-init.sh -y --no-modify-path \
        --default-toolchain none \
        --profile minimal && \
    rm /tmp/rustup-init.sh && \
    rustup toolchain install ${RUST_TOOLCHAIN} \
        --profile minimal \
        --component rustfmt \
        --component clippy && \
    rustup target add ${ANDROID_TARGETS} --toolchain ${RUST_TOOLCHAIN} && \
    cargo install cargo-ndk --locked

WORKDIR /src

# Download FFmpeg static libs for all supported Android targets.
# Uses the latest release so this stays current without manual version bumps.
RUN for target in ${ANDROID_TARGETS}; do \
        mkdir -p "/ffmpeg-libs/${target}" && \
        curl --no-alpn -fL --retry 5 --retry-all-errors \
            -o /tmp/ffmpeg.tar.gz \
            "https://github.com/TeamFlos/prpr-avc-ffmpeg/releases/latest/download/${target}.tar.gz" && \
        tar -xzf /tmp/ffmpeg.tar.gz -C "/ffmpeg-libs/${target}" && \
        rm /tmp/ffmpeg.tar.gz; \
    done

# Signing tools + apktool
RUN apt-get update && apt-get install -y --no-install-recommends \
    apksigner \
    zipalign \
    zip \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# apktool (latest stable jar + wrapper)
RUN curl --no-alpn -fsSL --retry 5 --retry-all-errors -o /usr/local/bin/apktool.jar \
        "https://github.com/iBotPeaches/Apktool/releases/download/v2.11.1/apktool_2.11.1.jar" && \
    printf '#!/bin/sh\nexec java -jar /usr/local/bin/apktool.jar "$@"\n' \
        > /usr/local/bin/apktool && \
    chmod +x /usr/local/bin/apktool

# Entrypoint: build the .so, then optionally sign the APK
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
